   "max_length": 0,
   "max_value": 0,
   "options": "\u0623\u0648\u0627\u0641\u0642 \u0628\u0645\u0648\u062c\u0628\u0647 \u0648\u0623\u0639\u0637\u064a \u0623\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0644\u0645\u0631\u0643\u0632 \u062f\u0628\u064a \u0644\u0644\u062a\u0648\u062d\u062f  \u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u062a\u0635\u0648\u064a\u0631  \u0637\u0641\u0644\u064a \u0648\u0639\u0631\u0636 \u0627\u0633\u0645\u0647 \u0648\u0639\u0645\u0644\u0647 \u0648\u0623\u062f\u0627\u0626\u0647 (\u064a\u0634\u0627\u0631 \u0625\u0644\u064a\u0647 \u0641\u064a\u0645\u0627 \u064a\u0644\u064a \u0628\u0627\u0633\u0645 \"\u0627\u0644\u0623\u0639\u0645\u0627\u0644\") \u0648\u0639\u0631\u0636 \u0647\u0630\u0647 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0623\u0648 \u0646\u0634\u0631\u0647\u0627 \u0623\u0648 \u062a\u0648\u0632\u064a\u0639\u0647\u0627 \u0644\u063a\u0631\u0636 \u0627\u0644\u062a\u0648\u0639\u064a\u0629 \u0623\u0648 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0641\u064a \u0643\u062a\u064a\u0628\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0632\u0648\u0627\u0644\u0646\u0634\u0631\u0627\u062a \u0627\u0644\u0625\u062e\u0628\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0645 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0648\u0627\u0644\u0635\u062d\u0641 \u0648\u0627\u0644\u0645\u062c\u0644\u0627\u062a \u0648 / \u0623\u0648 \u0644\u0644\u0628\u062b \u0639\u0644\u0649 \u0627\u0644\u062a\u0644\u0641\u0632\u064a\u0648\u0646 \u0623\u0648 \u0627\u0644\u0631\u0627\u062f\u064a\u0648 \u0639\u0644\u0649 \u0627\u0644\u0646\u062d\u0648 \u0627\u0644\u0630\u064a \u062a\u062d\u062f\u062f\u0647 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0631\u0643\u0632.",
